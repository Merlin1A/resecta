+/// Each search starts only once the one before it has ended.
+private enum OneSearchAtATime {
+    static let lock = NSLock()
+    nonisolated(unsafe) static var last: Task<Void, Never>?
+    static func after(_ body: @escaping @Sendable () async -> Void) -> Task<Void, Never> {
+        lock.withLock {
+            let before = last
+            let next = Task { await before?.value; await body() }
+            last = next
+            return next
+        }
+    }
+}
